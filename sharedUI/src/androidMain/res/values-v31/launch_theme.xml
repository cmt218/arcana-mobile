<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- The system launch screen as a plain moss field with no icon, so the dot
         splash appears to start on it instead of following a second splash. -->
    <style name="Theme.Arcana.Launch" parent="Base.Theme.Arcana.Launch">
        <item name="android:windowSplashScreenBackground">@color/launch_background</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/launch_icon_none</item>
    </style>
</resources>
